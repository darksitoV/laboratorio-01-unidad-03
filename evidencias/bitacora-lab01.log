2026-11-19 05:33:17.285 UTC [117] user=postgres db=comercial app=psql client=[local] LOG:  statement: CREATE OR REPLACE FUNCTION auditoria.registrar_cambio_cliente()
	RETURNS trigger
	LANGUAGE plpgsql
	SECURITY DEFINER
	SET search_path = pg_catalog, public
	AS $$
	BEGIN
	    IF TG_OP = 'INSERT' THEN
	        INSERT INTO auditoria.cambios_clientes (operacion, id_cliente, valores_despues)
	        VALUES (TG_OP, NEW.id, to_jsonb(NEW));
	        RETURN NEW;
	    ELSIF TG_OP = 'UPDATE' THEN
	        INSERT INTO auditoria.cambios_clientes (operacion, id_cliente, valores_antes, valores_despues)
	        VALUES (TG_OP, NEW.id, to_jsonb(OLD), to_jsonb(NEW));
	        RETURN NEW;
	    ELSIF TG_OP = 'DELETE' THEN
	        INSERT INTO auditoria.cambios_clientes (operacion, id_cliente, valores_antes)
	        VALUES (TG_OP, OLD.id, to_jsonb(OLD));
	        RETURN OLD;
	    END IF;
	    RETURN NULL;
	END;
	$$;
2026-11-19 05:33:17.293 UTC [117] user=postgres db=comercial app=psql client=[local] LOG:  statement: REVOKE ALL ON FUNCTION auditoria.registrar_cambio_cliente() FROM PUBLIC;
